{
  "name": "cement-portal",
  "version": "0.1.0",
  "private": true,
  "description": "پورتال الکترونیک مشتریان کارخانه سیمان خاکستری نی‌ریز - Monorepo",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @cement/api prisma migrate dev",
    "db:generate": "pnpm --filter @cement/api prisma generate",
    "db:seed": "pnpm --filter @cement/api prisma db seed",
    "db:studio": "pnpm --filter @cement/api prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.0.9",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.23.8"
    }
  }
}
