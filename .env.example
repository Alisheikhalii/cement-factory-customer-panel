# ==========================================================================
# نمونه فایل محیطی پورتال سیمان خاکستری نی‌ریز (Phase 0)
# این فایل را به `.env` کپی کنید و مقادیر واقعی را جایگزین نمایید.
# ==========================================================================

# --- عمومی ---
NODE_ENV=development

# --- PostgreSQL (دیتابیس اصلی پورتال - بخش ۳.۲ PRD) ---
POSTGRES_USER=cement
POSTGRES_PASSWORD=cement_dev_password
POSTGRES_DB=cement_portal
# داخل Docker از هاست `postgres` و بیرون از `localhost` استفاده کنید
DATABASE_URL=postgresql://cement:cement_dev_password@localhost:5432/cement_portal?schema=public

# --- Redis (Cache + BullMQ - بخش ۱۳.۱ PRD) ---
REDIS_URL=redis://localhost:6379

# --- JWT (بخش ۶.۱ PRD) ---
# Access Token عمر کوتاه، Refresh Token در httpOnly Cookie
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- ERP Adapter (بخش ۱۲ PRD) ---
# مقادیر مجاز: mock | sql-server | rest-api | file-based
# تا دریافت اطلاعات اتصال از کارخانه، mock بماند (بخش ۲۰.۲)
ERP_ADAPTER=mock
# تاخیر مصنوعی MockErpAdapter (میلی‌ثانیه) برای شبیه‌سازی Loading States
ERP_MOCK_LATENCY_MIN=200
ERP_MOCK_LATENCY_MAX=500

# --- ERP: اتصال مستقیم SQL Server (وقتی ERP_ADAPTER=sql-server) ---
# پس از دریافت اطلاعات از کارخانه فقط همین مقادیر پر می‌شوند؛ کد تغییر نمی‌کند.
ERP_SQL_HOST=
ERP_SQL_PORT=1433
ERP_SQL_DATABASE=
ERP_SQL_USER=
ERP_SQL_PASSWORD=
ERP_SQL_ENCRYPT=true
ERP_SQL_TRUST_SERVER_CERT=false
# نام View/پروسیجرهای قراردادی (اختیاری — پیش‌فرض portal_*)
# ERP_SQL_VIEW_CUSTOMERS=portal_customers
# ERP_SQL_VIEW_ORDERS=portal_orders
# ERP_SQL_VIEW_PRODUCTS=portal_products
# ERP_SQL_VIEW_INVENTORY=portal_inventory
# ERP_SQL_VIEW_DELIVERIES=portal_deliveries
# ERP_SQL_VIEW_INVOICES=portal_invoices
# ERP_SQL_PROC_SUBMIT_LOADING=portal_submit_loading_request
# ERP_SQL_PROC_SYNC_STATUS=portal_sync_loading_status

# --- ERP: سرویس REST میانی (وقتی ERP_ADAPTER=rest-api) ---
ERP_REST_BASE_URL=
ERP_REST_API_KEY=
ERP_REST_TIMEOUT_MS=15000
# مسیر Endpointها (اختیاری — پیش‌فرض‌ها: /customers /orders /products /inventory
# /deliveries /invoices /loading-requests /loading-status)
# ERP_REST_PATH_CUSTOMERS=/customers

# --- ERP: تبادل فایل CSV (وقتی ERP_ADAPTER=file-based) ---
# مسیر مشترک: ERP فایل‌های ورودی را در <dir>/in می‌گذارد؛ پورتال خروجی را در <dir>/out می‌نویسد.
ERP_FILE_EXCHANGE_DIR=
# ERP_FILE_IN_SUBDIR=in
# ERP_FILE_OUT_SUBDIR=out
# ERP_FILE_CUSTOMERS=customers.csv
# ERP_FILE_ORDERS=orders.csv
# ERP_FILE_PRODUCTS=products.csv
# ERP_FILE_INVENTORY=inventory.csv
# ERP_FILE_DELIVERIES=deliveries.csv
# ERP_FILE_INVOICES=invoices.csv

# --- کلید سرویس‌به‌سرویس داخلی (بخش ۶.۲ - برای mark-loaded در فاز ۶) ---
INTERNAL_API_KEY=change_me_internal_service_api_key

# --- Backend ---
API_PORT=3001
# آدرس مجاز CORS (Frontend)
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- آستانه «کاربر آنلاین» در داشبورد ادمین (بخش ۲۰.۲ مورد ۹) بر حسب دقیقه ---
ONLINE_USER_THRESHOLD_MINUTES=15

# --- SMTP (برای OTP/اعلان‌ها و فرم تماس عمومی) ---
# اگر SMTP_HOST خالی باشد، ارسال ایمیل فقط شبیه‌سازی/Log می‌شود (محیط توسعه).
# برای ارسال واقعی: `pnpm add nodemailer` + پر کردن این مقادیر.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nyrizcement.example
CONTACT_FORM_RECIPIENT=info@nyrizcement.example

# --- ذخیره‌سازی فایل (فاز ۷ — فیش واریزی) ---
# مسیر ریشهٔ ذخیرهٔ فایل‌های آپلودی روی دیسک (پیش‌فرض ./storage/uploads)
FILE_STORAGE_DIR=./storage/uploads

# --- Sentry (فاز ۷ — رهگیری خطا؛ اختیاری) ---
# اگر خالی باشد غیرفعال است. برای فعال‌سازی: `pnpm add @sentry/node` + مقدار DSN.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
